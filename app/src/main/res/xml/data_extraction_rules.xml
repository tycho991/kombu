<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the account DataStore (ACCOUNT_DATASTORE_NAME in :data) never leaves the device (design D9). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/account.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/account.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
