<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, with the system's trusted CAs (spec nextcloud-account, "HTTPS only"; design D10). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
