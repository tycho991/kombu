<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 10 and 11: the account DataStore (ACCOUNT_DATASTORE_NAME in :data) and the recipe database
    (RECIPE_DATABASE_NAME in :data) are not backed up (design D9 of nextcloud-login, spec recipe-sync
    "Local recipe data stays on the device"). Recipe images live in noBackupFilesDir, which is never backed up.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/account.preferences_pb" />
    <exclude domain="database" path="recipes.db" />
    <exclude domain="database" path="recipes.db-journal" />
    <exclude domain="database" path="recipes.db-wal" />
    <exclude domain="database" path="recipes.db-shm" />
</full-backup-content>
